<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="700.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.ProfilePageController">

   <children>

      <Label fx:id="lblWelcome" layoutX="360.0" layoutY="30.0" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.7), 4, 0.5, 0, 1);" text="Welcome to profile page!" textFill="#66bb6a">
         <font>
            <Font size="22.0" />
         </font></Label>

      <!-- Profile info -->
      <GridPane hgap="15" layoutX="140.0" layoutY="80.0" vgap="15">
         <children>
            <!-- Row 0: Name -->
            <Label text="Name:" textFill="#388e3c" style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.7), 3, 0.5, 0, 1);" GridPane.columnIndex="0" GridPane.rowIndex="0">
               <font><Font name="System Bold" size="14.0" /></font></Label>
            <Label fx:id="lblName" text="-" textFill="#2e7d32" style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.7), 3, 0.5, 0, 1);" GridPane.columnIndex="1" GridPane.rowIndex="0">
               <font><Font name="System Bold" size="14.0" /></font></Label>

            <Button fx:id="btnEditProfile" mnemonicParsing="false" onAction="#onEditProfile" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-background-radius: 5; -fx-font-size: 10px; -fx-padding: 3 8 3 8;" text="Edit" GridPane.columnIndex="2" GridPane.rowIndex="0" />

            <!-- Row 1: Email -->
            <Label text="Email:" textFill="#388e3c" style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.7), 3, 0.5, 0, 1);" GridPane.columnIndex="0" GridPane.rowIndex="1">
               <font><Font name="System Bold" size="14.0" /></font></Label>
            <Label fx:id="lblEmail" text="-" textFill="#2e7d32" style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.7), 3, 0.5, 0, 1);" GridPane.columnIndex="1" GridPane.rowIndex="1">
               <font><Font name="System Bold" size="14.0" /></font></Label>

            <!-- Row 2: Phone (clients) / Role (employees) — never both visible -->
            <Label fx:id="lblPhoneLabel" managed="false" text="Phone:" textFill="#388e3c" style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.7), 3, 0.5, 0, 1);" visible="false" GridPane.columnIndex="0" GridPane.rowIndex="2">
               <font><Font name="System Bold" size="14.0" /></font></Label>
            <Label fx:id="lblPhone" managed="false" text="-" textFill="#2e7d32" style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.7), 3, 0.5, 0, 1);" visible="false" GridPane.columnIndex="1" GridPane.rowIndex="2">
               <font><Font name="System Bold" size="14.0" /></font></Label>
            <Label fx:id="lblRoleLabel" managed="false" text="Role:" textFill="#388e3c" style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.7), 3, 0.5, 0, 1);" visible="false" GridPane.columnIndex="0" GridPane.rowIndex="2">
               <font><Font name="System Bold" size="14.0" /></font></Label>
            <Label fx:id="lblRoleValue" managed="false" text="-" textFill="#2e7d32" style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.7), 3, 0.5, 0, 1);" visible="false" GridPane.columnIndex="1" GridPane.rowIndex="2">
               <font><Font name="System Bold" size="14.0" /></font></Label>

            <!-- Row 3: Payment (clients only) -->
            <Label fx:id="lblPaymentLabel" text="Payment:" textFill="#388e3c" style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.7), 3, 0.5, 0, 1);" GridPane.columnIndex="0" GridPane.rowIndex="3">
               <font><Font name="System Bold" size="14.0" /></font></Label>
            <Label fx:id="lblPayment" text="-" textFill="#2e7d32" style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.7), 3, 0.5, 0, 1);" GridPane.columnIndex="1" GridPane.rowIndex="3">
               <font><Font name="System Bold" size="14.0" /></font></Label>
            <Button fx:id="btnChangePayment" managed="false" mnemonicParsing="false" onAction="#onChangePayment" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-background-radius: 5; -fx-font-size: 10px; -fx-padding: 3 8 3 8;" text="Change" visible="false" GridPane.columnIndex="2" GridPane.rowIndex="3" />

            <!-- Row 4: Inbox -->
            <Label text="Inbox:" textFill="#388e3c" style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.7), 3, 0.5, 0, 1);" GridPane.columnIndex="0" GridPane.rowIndex="4">
               <font><Font name="System Bold" size="14.0" /></font></Label>
            <Label fx:id="lblInbox" text="You have 0 new messages" textFill="#388e3c" style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.7), 3, 0.5, 0, 1);" GridPane.columnIndex="1" GridPane.rowIndex="4">
               <font><Font name="System Bold" size="14.0" /></font></Label>

            <!-- Row 5: Purchase History button (clients only, hidden by default) -->
            <Button fx:id="btnPurchaseHistory" managed="false" mnemonicParsing="false" onAction="#onPurchaseHistory" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="Purchase History" visible="false" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="5" />
         </children>
         <columnConstraints>
            <ColumnConstraints />
            <ColumnConstraints />
            <ColumnConstraints />
         </columnConstraints>
         <rowConstraints>
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
         </rowConstraints>
      </GridPane>

      <!-- Inbox table -->
      <Label layoutX="140.0" layoutY="320.0" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.7), 3, 0.5, 0, 1);" text="Inbox messages:" textFill="#a0b0a0" />

      <TableView fx:id="tblInbox" layoutX="140.0" layoutY="350.0" prefHeight="300.0" prefWidth="720.0">
         <columns>
            <TableColumn fx:id="colFrom" prefWidth="140.0" text="From" />
            <TableColumn fx:id="colSubject" prefWidth="260.0" text="Topic" />
            <TableColumn fx:id="colDate" prefWidth="140.0" text="Date" />
            <TableColumn fx:id="colPreview" prefWidth="180.0" text="Preview" />
         </columns>
      </TableView>

   </children>
</AnchorPane>
